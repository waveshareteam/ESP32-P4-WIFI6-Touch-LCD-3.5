                connecting: 'РџС–РґРєР»СЋС‡РµРЅРЅСЏ...',
                select_wifi: 'Р’РёР±РµСЂС–С‚СЊ Wi-Fi 2.4G Р·С– СЃРїРёСЃРєСѓ РЅРёР¶С‡Рµ:',
                select_wifi_5g: 'Р’РёР±РµСЂС–С‚СЊ Wi-Fi Р·С– СЃРїРёСЃРєСѓ РЅРёР¶С‡Рµ:',
                scanning: 'РЎРєР°РЅСѓРІР°РЅРЅСЏ...',
                wifi_tab: 'РќР°Р»Р°С€С‚СѓРІР°РЅРЅСЏ Wi-Fi',
                advanced_tab: 'Р”РѕРґР°С‚РєРѕРІРѕ',
                ota_url: 'РљРѕСЂРёСЃС‚СѓРІР°С†СЊРєР° URL-Р°РґСЂРµСЃР° OTA:',
                max_tx_power: 'РњР°РєСЃ. РїРѕС‚СѓР¶РЅС–СЃС‚СЊ РїРµСЂРµРґР°С‡С– Wi-Fi:',
                remember_bssid: 'Р—Р°РїР°Рј\'СЏС‚Р°С‚Рё BSSID РїСЂРё РїС–РґРєР»СЋС‡РµРЅРЅС– РґРѕ Wi-Fi',
                sleep_mode: 'РЈРІС–РјРєРЅСѓС‚Рё СЂРµР¶РёРј СЃРЅСѓ',
